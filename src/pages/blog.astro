---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.section === 'Blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog">
  <section class="page-hero shell compact-hero">
    <p class="eyebrow">Blog</p>
    <h1 class="lang-en">Things worth writing down.</h1>
    <h1 class="lang-vi">Những thứ đáng để viết lại.</h1>
    <p class="lang-en">Repos I find interesting, engineering lessons, experiments, opinions and small ideas that do not need to become handbook chapters.</p>
    <p class="lang-vi">Repo thú vị, bài học engineering, experiment, góc nhìn cá nhân và những ý nhỏ không cần trở thành một chương trong handbook.</p>
  </section>
  <section class="shell page-section blog-index">
    {posts.length ? posts.map(post => (
      <a class="note-row" href={withBase(`/articles/${post.id}`)}>
        <time>{post.data.pubDate.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'2-digit' })}</time>
        <div><strong>{post.data.title}</strong><span>{post.data.description}</span></div>
        <em>{post.data.language.toUpperCase()}</em><i>→</i>
      </a>
    )) : (
      <div class="notes-empty">
        <span>BLOG / 000</span>
        <h2><span class="lang-en">Nothing here yet.</span><span class="lang-vi">Chưa có bài viết.</span></h2>
        <p><span class="lang-en">This section is intentionally empty so the blog starts with your own writing.</span><span class="lang-vi">Phần này được để trống có chủ đích để blog bắt đầu bằng chính những bài bạn viết.</span></p>
      </div>
    )}
  </section>
</BaseLayout>
