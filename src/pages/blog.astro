---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { langClass } from '../lib/translations';

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.section === 'Blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog">
  <section class="page-hero shell compact-hero">
    <p class="eyebrow">Blog</p>
    <h1>
      <span class="lang-en">Things worth writing down.</span>
      <span class="lang-vi">Những thứ đáng để viết lại.</span>
    </h1>
    <p class="compact-lede">
      <span class="lang-en">
        Deep dives into real-world AI systems, papers, experiments, and engineering lessons beyond the handbook's core learning path.
      </span>
      <span class="lang-vi">
        Các bài đào sâu về hệ thống AI thực tế, paper, thử nghiệm và bài học engineering nằm ngoài lộ trình cốt lõi của handbook.
      </span>
    </p>
  </section>

  <section class="shell page-section blog-index">
    {posts.length ? (
      <div class="blog-grid">
        {posts.map(post => (
          <article class:list={['blog-card-wrap', langClass(post, posts)]}>
            <a class="blog-card" href={withBase(`/articles/${post.id}`)}>
              <div class="blog-card-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString(post.data.language === 'vi' ? 'vi-VN' : 'en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span class="blog-badge">{post.data.language.toUpperCase()}</span>
              </div>
              <h2 class="blog-card-title">{post.data.title}</h2>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-card-footer">
                <span class="blog-read-more">
                  <span class="lang-en">Read article</span><span class="lang-vi">Đọc bài viết</span>
                </span>
                <i aria-hidden="true">→</i>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="notes-empty">
        <h2><span class="lang-en">Nothing here yet.</span><span class="lang-vi">Chưa có bài viết nào.</span></h2>
        <p>
          <span class="lang-en">
            This section is intentionally empty so the blog starts with real writing rather than filler.
            In the meantime, the handbook is where most of the material lives.
          </span>
          <span class="lang-vi">
            Phần này được để trống có chủ đích để blog bắt đầu bằng bài viết thật thay vì nội dung lấp chỗ.
            Trong lúc chờ, phần lớn nội dung đang nằm ở handbook.
          </span>
        </p>
        <a class="button primary" href={withBase('/learn/')}>
          <span class="lang-en">Go to the handbook</span><span class="lang-vi">Tới mục Học AI</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </section>
</BaseLayout>
