---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { KNOWLEDGE } from '../data/knowledge';
import { withBase } from '../lib/url';
import { domainKey } from '../lib/labels';
import { countArticles } from '../lib/translations';

const posts = await getCollection('posts', ({ data }) => !data.draft && data.section === 'Learn');
const total = countArticles(posts);
---
<BaseLayout title="Learn">
  <section class="docs-index shell">
    <header class="docs-index-intro">
      <h1>
        <span class="lang-en">Learn AI from the foundations up.</span>
        <span class="lang-vi">Học AI từ nền tảng đi lên.</span>
      </h1>
      <p class="docs-index-lede">
        <span class="lang-en">
          Six chapters{total > 0 && `, ${total} ${total === 1 ? 'article' : 'articles'}`}. Each chapter starts with the core intuition, then builds toward how the ideas work in practice. Read them in order, or jump straight to what you need.
        </span>
        <span class="lang-vi">
          Sáu chương{total > 0 && `, ${total} bài viết`}. Mỗi chương bắt đầu từ trực giác cốt lõi rồi đi dần tới cách các ý tưởng vận hành trong thực tế. Bạn có thể đọc theo thứ tự hoặc đi thẳng tới phần mình cần.
        </span>
      </p>
    </header>

    <ol class="chapter-list">
      {KNOWLEDGE.map(section => {
        const count = countArticles(posts.filter(post => domainKey(post.data.domain) === section.id));
        return (
          <li>
            <a class="chapter-card" href={withBase(`/learn/${section.id}`)}>
              <div class="chapter-card-head">
                <h2><span class="lang-en">{section.title}</span><span class="lang-vi">{section.viTitle}</span></h2>
                {count > 0 && (
                  <span class="chapter-count">
                    {count} <span class="lang-en">{count === 1 ? 'article' : 'articles'}</span><span class="lang-vi">bài</span>
                  </span>
                )}
              </div>
              <p class="chapter-card-body">
                <span class="lang-en">{section.body}</span><span class="lang-vi">{section.viBody}</span>
              </p>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>
