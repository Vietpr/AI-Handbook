---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { pickFor, byOrder } from '../../lib/translations';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

let previous = undefined;
let next = undefined;
if (post.data.section === 'Learn' || post.data.section === 'Algorithms') {
  /* Previous / next walk the chapter in this article's language, so a reader
     of the Vietnamese version is handed the next Vietnamese lesson. */
  const siblings = pickFor(post.data.language, (await getCollection('posts', ({ data }) =>
    !data.draft && data.section === post.data.section && data.domain === post.data.domain)).sort(byOrder));
  const index = siblings.findIndex(item => item.id === post.id);
  previous = index > 0 ? siblings[index - 1] : undefined;
  next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
}
---
<ArticleLayout post={post} headings={headings} previous={previous} next={next}>
  <Content />
</ArticleLayout>
