---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import HandbookSidebar from '../components/HandbookSidebar.astro';
import ArticleToc from '../components/ArticleToc.astro';
import TextSize from '../components/TextSize.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { domainKey, TYPE_VI } from '../lib/labels';
import { translationOf, pickFor, byOrder } from '../lib/translations';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  post: CollectionEntry<'posts'>;
  headings: Heading[];
  previous?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}
const { post, headings, previous, next } = Astro.props;
const lang = post.data.language;
const locale = lang === 'vi' ? 'vi-VN' : 'en-US';
const date = post.data.pubDate.toLocaleDateString(locale, { month: 'long', day: 'numeric', year: 'numeric' });

/* The same article in the other language, when the author wrote one. */
const published = await getCollection('posts', ({ data }) => !data.draft);
const translation = translationOf(post, published);
const alternates = {
  [lang]: withBase(`/articles/${post.id}`),
  ...(translation ? { [translation.data.language]: withBase(`/articles/${translation.id}`) } : {}),
};

const isHandbook = post.data.section === 'Learn';
const handbookPosts = isHandbook ? published.filter(item => item.data.section === 'Learn') : [];
/* The in-page chapter list is static, so it shows the chapter in this
   article's language: one entry per lesson, translated where possible. */
const chapterPosts = pickFor(lang, handbookPosts
  .filter(item => domainKey(item.data.domain) === domainKey(post.data.domain))
  .sort(byOrder));

const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = toc.filter(h => h.depth === 2).length > 1;
const back = post.data.section === 'Algorithms' ? '/algorithms' : post.data.section === 'Blog' ? '/blog' : '/learn';
const backLabel = post.data.section === 'Algorithms' ? 'Algorithms' : post.data.section === 'Blog' ? 'Blog' : 'Learn';
const backLabelVi = post.data.section === 'Algorithms' ? 'Thuật toán' : post.data.section === 'Blog' ? 'Blog' : 'Học AI';
---
<BaseLayout title={post.data.title} description={post.data.description} lang={lang} alternates={alternates}>
  <div class="read-progress" aria-hidden="true"><span></span></div>

  {isHandbook ? (
    <div class="handbook-layout shell-wide article-handbook-layout">
      <HandbookSidebar posts={handbookPosts} currentDomain={domainKey(post.data.domain)} currentPostId={post.id} />

      <article class="doc-article">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={withBase('/learn')}><span class="lang-en">Learn</span><span class="lang-vi">Học AI</span></a><span aria-hidden="true">›</span>
          <a href={withBase(`/learn/${domainKey(post.data.domain)}`)}>{post.data.domain}</a><span aria-hidden="true">›</span>
          <span aria-current="page">{post.data.title}</span>
        </nav>

        {chapterPosts.length > 1 && (
          <details class="chapter-nav">
            <summary>
              <span class="lang-en">All lessons in {post.data.domain}</span>
              <span class="lang-vi">Tất cả bài trong chương {post.data.domain}</span>
              <span class="toc-count">{chapterPosts.length}</span>
            </summary>
            <nav>
              {chapterPosts.map((item, i) => (
                <a class:list={[{ active: item.id === post.id }]} href={withBase(`/articles/${item.id}`)}>
                  <span>{String(i + 1).padStart(2, '0')}</span>{item.data.title}
                </a>
              ))}
            </nav>
          </details>
        )}

        <header class="doc-header">
          <h1>{post.data.title}</h1>
          <p class="doc-dek">{post.data.description}</p>
          <div class="doc-meta">
            <span>{date}</span>
            <TextSize />
          </div>
        </header>

        {showToc && <ArticleToc headings={toc} variant="inline" />}

        <div class="prose"><slot /></div>

        {(previous || next) && (
          <nav class="article-sequence" aria-label="Article sequence">
            {previous ? (
              <a href={withBase(`/articles/${previous.id}`)}>
                <span><span aria-hidden="true">←</span> <span class="lang-en">Previous</span><span class="lang-vi">Bài trước</span></span>
                <strong>{previous.data.title}</strong>
              </a>
            ) : <div></div>}
            {next ? (
              <a class="next" href={withBase(`/articles/${next.id}`)}>
                <span><span class="lang-en">Next</span><span class="lang-vi">Bài tiếp</span> <span aria-hidden="true">→</span></span>
                <strong>{next.data.title}</strong>
              </a>
            ) : <div></div>}
          </nav>
        )}

        <div class="shortcuts-hint" aria-hidden="true">
          <span class="lang-en">Shortcuts:</span><span class="lang-vi">Phím tắt:</span>
          <kbd>[</kbd><kbd>]</kbd> <span class="lang-en">flip</span><span class="lang-vi">chuyển bài</span> •
          <kbd>Z</kbd> <span class="lang-en">Zen</span><span class="lang-vi">tập trung</span> •
          <kbd>T</kbd> <span class="lang-en">outline</span><span class="lang-vi">mục lục</span>
        </div>
      </article>

      {showToc && <ArticleToc headings={toc} variant="rail" />}
    </div>
  ) : (
    <div class:list={['standalone-wrapper', { 'standalone-layout shell': showToc, 'shell-reading': !showToc }]}>
      <article class="standalone-article">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={withBase(back)}>
            <span aria-hidden="true">←</span> <span class="lang-en">{backLabel}</span><span class="lang-vi">{backLabelVi}</span>
          </a>
        </nav>
        <header class="doc-header">
          {post.data.section === 'Algorithms' && (
            /* Only Algorithms has two kinds worth telling apart; on Blog the label
               would say "Concept" on every single post. */
            <p class="section-label">
              <span class="lang-en">{post.data.type}</span><span class="lang-vi">{TYPE_VI[post.data.type] ?? post.data.type}</span>
            </p>
          )}
          <h1>{post.data.title}</h1>
          <p class="doc-dek">{post.data.description}</p>
          <div class="doc-meta">
            <span>{date}</span>
            <TextSize />
          </div>
        </header>

        {showToc && <ArticleToc headings={toc} variant="inline" />}

        <div class="prose"><slot /></div>

        {(previous || next) && (
          <nav class="article-sequence" aria-label="Article sequence">
            {previous ? (
              <a href={withBase(`/articles/${previous.id}`)}>
                <span><span aria-hidden="true">←</span> <span class="lang-en">Previous</span><span class="lang-vi">Bài trước</span></span>
                <strong>{previous.data.title}</strong>
              </a>
            ) : (
              <a href={withBase(back)} class="sequence-back">
                <span><span aria-hidden="true">←</span> <span class="lang-en">{backLabel}</span><span class="lang-vi">{backLabelVi}</span></span>
                <strong><span class="lang-en">All articles</span><span class="lang-vi">Tất cả bài viết</span></strong>
              </a>
            )}
            {next ? (
              <a class="next" href={withBase(`/articles/${next.id}`)}>
                <span><span class="lang-en">Next</span><span class="lang-vi">Bài tiếp</span> <span aria-hidden="true">→</span></span>
                <strong>{next.data.title}</strong>
              </a>
            ) : (
              <a class="next sequence-back" href={withBase(back)}>
                <span><span class="lang-en">{backLabel}</span><span class="lang-vi">{backLabelVi}</span> <span aria-hidden="true">→</span></span>
                <strong><span class="lang-en">All articles</span><span class="lang-vi">Tất cả bài viết</span></strong>
              </a>
            )}
          </nav>
        )}

        <div class="shortcuts-hint" aria-hidden="true">
          <span class="lang-en">Shortcuts:</span><span class="lang-vi">Phím tắt:</span>
          <kbd>[</kbd><kbd>]</kbd> <span class="lang-en">flip</span><span class="lang-vi">chuyển bài</span> •
          <kbd>Z</kbd> <span class="lang-en">Zen</span><span class="lang-vi">tập trung</span> •
          <kbd>T</kbd> <span class="lang-en">outline</span><span class="lang-vi">mục lục</span>
        </div>
      </article>

      {showToc && <ArticleToc headings={toc} variant="rail" />}
    </div>
  )}

  <div class="zen-exit-pill" id="zen-exit-pill">
    <button type="button" data-zen-exit>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6m0 0v6m0-6L3 21m17-7h-6m0 0v6m0-6l7 7M10 10H4m6 0V4m0 6L3 3m14 7h6m-6 0V4m0 6l7-7"></path></svg>
      <span class="lang-en">Exit Zen</span><span class="lang-vi">Thoát Zen</span>
      <kbd>Esc</kbd>
    </button>
  </div>
  <button class="to-top" type="button" aria-label="Back to top" hidden><span aria-hidden="true">↑</span></button>
</BaseLayout>

<script>
  import { mountDiagrams, prepareDiagrams } from '../lib/diagrams';

  let articleController: AbortController | undefined;

  /* Stop observers before Astro changes root attributes or detaches the old
     article. Waiting until page-load lets theme observers redraw that article. */
  document.addEventListener('astro:before-swap', (event) => {
    articleController?.abort();
    prepareDiagrams(event.newDocument, event.to);
  });

  document.addEventListener('astro:page-load', () => {
  articleController?.abort();
  articleController = new AbortController();
  const { signal } = articleController;
  const prose = document.querySelector('.prose');
  if (!prose) return;

  /* Reading progress ------------------------------------------------------ */
  const progress = document.querySelector<HTMLElement>('.read-progress span');
  const toTop = document.querySelector<HTMLButtonElement>('.to-top');

  function onScroll() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    if (progress) progress.style.transform = `scaleX(${ratio})`;
    if (toTop) toTop.hidden = window.scrollY < 600;
  }
  window.addEventListener('scroll', onScroll, { passive: true, signal });
  window.addEventListener('resize', onScroll, { signal });
  onScroll();

  toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }), { signal });

  /* Table of contents scroll-spy ------------------------------------------ */
  const railLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.doc-toc [data-toc-link]'));
  if (railLinks.length && prose) {
    const targets = railLinks
      .map(link => document.getElementById(link.dataset.tocLink || ''))
      .filter((el): el is HTMLElement => Boolean(el));

    const setActive = (slug: string) => {
      railLinks.forEach(link => link.classList.toggle('active', link.dataset.tocLink === slug));
    };

    const observer = new IntersectionObserver(entries => {
      const visible = entries
        .filter(entry => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible) {
        setActive(visible.target.id);
        return;
      }
      // Nothing in the band: fall back to the last heading scrolled past.
      const passed = targets.filter(el => el.getBoundingClientRect().top < 120).pop();
      if (passed) setActive(passed.id);
    }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

    targets.forEach(el => observer.observe(el));
    signal.addEventListener('abort', () => observer.disconnect(), { once: true });
  }

  /* Copy button on every code block --------------------------------------- */
  /* Labels ship in both languages so the EN/VI switch keeps working after the
     button has already been created. */
  const label = (en: string, vi: string) =>
    `<span class="lang-en">${en}</span><span class="lang-vi">${vi}</span>`;

  prose?.querySelectorAll('pre:not([data-language="mermaid"])').forEach(pre => {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const lang = pre.getAttribute('data-language') ||
      Array.from(pre.classList).find(c => c.startsWith('language-'))?.replace('language-', '') ||
      pre.querySelector('code')?.className.match(/language-([\w-]+)/)?.[1] ||
      '';

    if (lang && !['plaintext', 'text', 'none'].includes(lang.toLowerCase())) {
      wrap.classList.add('has-badge');
      const badge = document.createElement('span');
      badge.className = 'code-lang-badge';
      badge.textContent = lang.toUpperCase();
      wrap.appendChild(badge);
    }

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.dataset.state = 'idle';
    button.innerHTML =
      `<span class="copy-idle">${label('Copy', 'Sao chép')}</span>` +
      `<span class="copy-done">${label('Copied', 'Đã chép')}</span>` +
      `<span class="copy-fail">${label('Failed', 'Lỗi')}</span>`;
    wrap.appendChild(button);

    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        button.dataset.state = 'done';
      } catch {
        button.dataset.state = 'fail';
      }
      clearTimeout(timer);
      timer = setTimeout(() => { button.dataset.state = 'idle'; }, 1600);
    }, { signal });
  });

  /* Mermaid diagrams ------------------------------------------------------ */
  /* Draw near the viewport and reuse SVGs on return visits. */
  const diagrams = Array.from(prose?.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]') ?? []);
  if (diagrams.length) {
    const vi = document.documentElement.lang === 'vi';

    /* Lightbox: a copy of the drawn SVG on a backdrop with zoom controls.
       100% is the diagram's natural size (16px labels); it opens at whichever
       is larger, fit-to-screen or 100%, so labels are never tiny. The copy is
       taken at click time so it always matches the current theme. */
    let box: HTMLDivElement | null = null;
    const closeBox = () => {
      if (!box) return;
      box.remove(); box = null;
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
    };
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') closeBox(); };
    signal.addEventListener('abort', closeBox, { once: true });
    const enlarge = (pre: HTMLPreElement) => {
      const svg = pre.querySelector('svg');
      if (!svg || box) return;
      const natural = parseFloat(svg.style.maxWidth || '') || svg.getBoundingClientRect().width || 900;
      const vb = svg.viewBox.baseVal;
      const aspect = vb && vb.width ? vb.height / vb.width : 0.5;

      box = document.createElement('div');
      box.className = 'diagram-lightbox';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-modal', 'true');
      box.setAttribute('aria-label', vi ? 'Sơ đồ phóng to' : 'Enlarged diagram');
      const panel = document.createElement('div');
      panel.className = 'diagram-lightbox-panel';
      const copy = svg.cloneNode(true) as SVGSVGElement;
      copy.removeAttribute('style');
      copy.removeAttribute('width');
      copy.removeAttribute('height');
      panel.appendChild(copy);

      const bar = document.createElement('div');
      bar.className = 'diagram-lightbox-bar';
      const mk = (label: string, title: string, cls = '') => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'diagram-lightbox-btn ' + cls; b.textContent = label; b.title = title; b.setAttribute('aria-label', title);
        return b;
      };
      const minus = mk('−', vi ? 'Thu nhỏ' : 'Zoom out');
      const pct = mk('100%', vi ? 'Về 100%' : 'Reset to 100%', 'pct');
      const plus = mk('+', vi ? 'Phóng to' : 'Zoom in');
      const fitBtn = mk(vi ? 'Vừa khung' : 'Fit', vi ? 'Vừa màn hình' : 'Fit to screen', 'fit');
      const close = mk('', vi ? 'Đóng' : 'Close', 'close');
      close.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
      bar.append(minus, pct, plus, fitBtn, close);

      const hint = document.createElement('p');
      hint.className = 'diagram-lightbox-hint';
      hint.textContent = vi
        ? 'Ctrl + lăn chuột hoặc chụm hai ngón để zoom · kéo để di chuyển · Esc để đóng'
        : 'Ctrl + scroll or pinch to zoom · drag to pan · Esc to close';
      box.append(bar, panel, hint);

      const fitScale = () => {
        const w = panel.clientWidth - 40 || Math.min(innerWidth * 0.96, 1500) - 40;
        const h = innerHeight - 170;
        return Math.min(w / natural, h / (natural * aspect));
      };
      let scale = 1;
      const apply = (next: number, cx?: number, cy?: number) => {
        const clamped = Math.min(4, Math.max(0.4, next));
        const ratio = clamped / scale;
        /* keep the point under the cursor (or the centre) in place */
        const px = cx ?? panel.clientWidth / 2, py = cy ?? panel.clientHeight / 2;
        const sx = panel.scrollLeft, sy = panel.scrollTop;
        scale = clamped;
        copy.style.width = `${Math.round(natural * scale)}px`;
        panel.scrollLeft = (sx + px) * ratio - px;
        panel.scrollTop = (sy + py) * ratio - py;
        pct.textContent = `${Math.round(scale * 100)}%`;
      };
      minus.onclick = () => apply(scale / 1.25);
      plus.onclick = () => apply(scale * 1.25);
      pct.onclick = () => apply(1);
      fitBtn.onclick = () => apply(fitScale());
      close.onclick = closeBox;

      /* ctrl/⌘ + wheel and trackpad pinch zoom around the cursor */
      panel.addEventListener('wheel', (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        const r = panel.getBoundingClientRect();
        apply(scale * Math.exp(-e.deltaY * 0.01), e.clientX - r.left, e.clientY - r.top);
      }, { passive: false });

      /* drag to pan with a mouse; touch uses native scrolling and pinch */
      let drag: { x: number; y: number; sx: number; sy: number } | null = null;
      panel.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        drag = { x: e.clientX, y: e.clientY, sx: panel.scrollLeft, sy: panel.scrollTop };
        panel.setPointerCapture(e.pointerId);
        panel.classList.add('dragging');
      });
      panel.addEventListener('pointermove', (e) => {
        if (!drag) return;
        panel.scrollLeft = drag.sx - (e.clientX - drag.x);
        panel.scrollTop = drag.sy - (e.clientY - drag.y);
      });
      const endDrag = () => { drag = null; panel.classList.remove('dragging'); };
      panel.addEventListener('pointerup', endDrag);
      panel.addEventListener('pointercancel', endDrag);

      box.addEventListener('click', (e) => { if (e.target === box || e.target === hint) closeBox(); });
      document.body.appendChild(box);
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      apply(Math.max(fitScale(), 1));
      /* centre a diagram that starts wider than the panel */
      panel.scrollLeft = Math.max(0, (panel.scrollWidth - panel.clientWidth) / 2);
      close.focus();
    };

    mountDiagrams(diagrams, signal, (pre) => {
      pre.tabIndex = 0;
      pre.setAttribute('role', 'button');
      pre.title = vi ? 'Bấm để phóng to' : 'Click to enlarge';
      pre.onclick = () => enlarge(pre);
      pre.onkeydown = (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enlarge(pre); }
      };
    });
  }

  /* Zen Mode & Keyboard Shortcuts ----------------------------------------- */
  const root = document.documentElement;
  const exitPill = document.querySelector<HTMLButtonElement>('[data-zen-exit]');
  exitPill?.addEventListener('click', () => {
    delete root.dataset.zenMode;
  }, { signal });

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    if (['INPUT', 'TEXTAREA'].includes(target?.tagName) || target?.isContentEditable) return;
    if (document.querySelector('.search-dialog:not([hidden])')) return;

    if (e.key === '[' || e.key === 'p') {
      const prev = document.querySelector<HTMLAnchorElement>('.article-sequence a:not(.next):not(.sequence-back)');
      if (prev) prev.click();
    } else if (e.key === ']' || e.key === 'n') {
      const next = document.querySelector<HTMLAnchorElement>('.article-sequence a.next:not(.sequence-back)');
      if (next) next.click();
    } else if (e.key === 'z' || e.key === 'Z') {
      if (root.dataset.zenMode === 'true') delete root.dataset.zenMode;
      else root.dataset.zenMode = 'true';
    } else if (e.key === 't' || e.key === 'T') {
      const tocToggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
      if (tocToggle) tocToggle.click();
    } else if (e.key === 'Escape') {
      if (root.dataset.zenMode === 'true') delete root.dataset.zenMode;
    }
  }, { signal });
  });
</script>
