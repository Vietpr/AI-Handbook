---
/*
 * Reading text-size control. Sets html[data-text-size] (1–4), which drives the
 * --prose-size custom property; every font size inside .prose is expressed in
 * em, so the whole article scales from that one value.
 */
---
<div class="reading-controls" role="group" aria-label="Reading controls">
  <div class="text-size" role="group" aria-label="Text size">
    <button type="button" data-text-step="-1" aria-label="Decrease text size" title="Smaller text">A<span aria-hidden="true">−</span></button>
    <button type="button" data-text-step="1" aria-label="Increase text size" title="Larger text">A<span aria-hidden="true">+</span></button>
  </div>
  <button type="button" class="reading-opt-btn font-toggle" data-font-toggle aria-label="Toggle font family" title="Toggle font (Sans / Serif)">
    <span class="font-sans-active">Serif</span>
    <span class="font-serif-active">Sans</span>
  </button>
  <button type="button" class="reading-opt-btn zen-toggle" data-zen-toggle aria-label="Toggle Zen mode" title="Focus reading mode (Z)">
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
    </svg>
    <span>Zen</span>
  </button>
</div>

<script>
  const MIN = 1;
  const MAX = 4;
  const DEFAULT = 2;
  let textSizeController: AbortController | undefined;

  document.addEventListener('astro:page-load', () => {
    textSizeController?.abort();
    textSizeController = new AbortController();
    const { signal } = textSizeController;
    const root = document.documentElement;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-text-step]'));

    const current = () => {
      const value = Number(root.dataset.textSize);
      return Number.isFinite(value) ? Math.min(MAX, Math.max(MIN, value)) : DEFAULT;
    };

    function apply(next: number) {
      const size = Math.min(MAX, Math.max(MIN, next));
      root.dataset.textSize = String(size);
      try {
        localStorage.setItem('text-size', String(size));
      } catch {
        /* Private mode: the choice just doesn't persist. */
      }
      buttons.forEach(button => {
        const step = Number(button.dataset.textStep);
        button.disabled = step < 0 ? size === MIN : size === MAX;
      });
    }

    buttons.forEach(button => {
      button.addEventListener('click', () => apply(current() + Number(button.dataset.textStep)), { signal });
    });

    apply(current());

    /* Font toggle -------------------------------------------------------- */
    document.querySelectorAll<HTMLButtonElement>('[data-font-toggle]').forEach(button => {
      button.addEventListener('click', () => {
        const isSerif = root.dataset.font === 'serif';
        if (isSerif) delete root.dataset.font;
        else root.dataset.font = 'serif';
        try { localStorage.setItem('font', isSerif ? 'sans' : 'serif'); } catch {}
      }, { signal });
    });

    /* Zen mode toggle ---------------------------------------------------- */
    document.querySelectorAll<HTMLButtonElement>('[data-zen-toggle]').forEach(button => {
      button.addEventListener('click', () => {
        const isZen = root.dataset.zenMode === 'true';
        if (isZen) delete root.dataset.zenMode;
        else root.dataset.zenMode = 'true';
      }, { signal });
    });
  });
</script>
